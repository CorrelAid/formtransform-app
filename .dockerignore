# Docker ignore file for optimized builds

# Node modules
node_modules/

# Build output
build/

# Logs and temporary files
*.log
*.tmp
*.swp

# IDE and editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Test and coverage files
test-results/
coverage/

# Environment files
.env
.env.local
.env.*.local

# Git files
.git/
.gitignore

# PNPM cache
.pnpm-store/

# Misc
.DS_Store



# Lock files (will be installed during build)
pnpm-lock.yaml