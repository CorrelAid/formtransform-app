{
	"name": "formtransform-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve": "node serve.js",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "[ -d node_modules/@correlaid/cdl-design/dist/favicons ] && cp node_modules/@correlaid/cdl-design/dist/favicons/* static/ || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bunx playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.3",
		"@playwright/test": "1.58.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.19.13",
		"@vitest/browser-playwright": "^4.0.18",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.4.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@correlaid/cdl-design": "github:CorrelAid/cdl-design",
		"@correlaid/formtransform": "github:CorrelAid/formtransform",
		"marked": "^17.0.5",
		"xlsx": "^0.18.5"
	},
	"trustedDependencies": [
		"@correlaid/formtransform"
	],
	"patchedDependencies": {
		"js-xpath@0.0.4": "patches/js-xpath@0.0.4.patch"
	}
}
